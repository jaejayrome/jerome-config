# Brewfile — install with: brew bundle --file=~/jerome-config/Brewfile
# Regenerate a snapshot of everything installed with: brew bundle dump --force

# --- Shell & prompt ---
brew "starship"
brew "zsh-autosuggestions"
brew "zsh-syntax-highlighting"

# --- Core CLI replacements / tools referenced by .zshrc ---
brew "bat"           # cat with syntax highlighting
brew "eza"           # modern ls
brew "fd"            # modern find
brew "fzf"           # fuzzy finder
brew "ripgrep"       # fast grep (rg)
brew "zoxide"        # smarter cd
brew "git-delta"     # git diff pager
brew "jq"            # JSON processor
brew "tree"
brew "wget"
brew "coreutils"     # GNU coreutils
brew "tealdeer"      # tldr client

# --- Editor & multiplexer ---
brew "neovim"
brew "tmux"
brew "lazygit"

# --- Languages / runtimes ---
brew "go"
brew "rust"
brew "rustup"
brew "uv"            # python package manager
brew "nvm"           # node version manager

# --- Security / misc ---
brew "gnupg"

# --- Casks ---
cask "muxy"
cask "font-jetbrains-mono-nerd-font"
